# Copy to .env and fill in.  Never commit .env.

PORT=8000
DATABASE_PATH=./database/app.db

# Comma-separated list of allowed browser origins.
# Leave unset in dev to default to http://localhost:3000.
# NEVER leave this empty in production - an empty value blocks all cross-origin calls
# rather than allowing them (fail-closed).
FRONTEND_ORIGIN=http://localhost:3000

# REQUIRED to use any mutating route (create/update/delete customer, delete task,
# send mail). If unset, those routes return 503 instead of silently allowing access.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Groq ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- SMTP (required only by POST /api/mail/send) ---
# The From address is ALWAYS forced to SMTP_USER; the address the user types is
# used as Reply-To. This prevents the API from being used as an open relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Name every generated email is signed off with, and the display name on the
# From header.
MAIL_SENDER_NAME=Regina Grane

# --- Limits ---
MAX_PROMPT_CHARS=2000
AGENT_RATE_PER_MIN=20
MAIL_RATE_PER_MIN=10
CUSTOMER_RATE_PER_MIN=60
